.page{padding:24px 18px;background:#f5f5f5;color:#171717;min-height:100vh;box-sizing:border-box}.eyebrow,.title,.description,.hint,.report{display:block}.eyebrow{font-size:10px;letter-spacing:2px;color:#666}.title{font-size:25px;font-weight:600;margin:16px 0}.description{font-size:12px;line-height:1.8;color:#666;margin:14px 0}.tiny{position:absolute;width:1px;height:1px;opacity:0}.scene{position:relative;height:220px;margin:20px 0;border-radius:8px;overflow:hidden}.canvas{width:100%;height:220px}.labels{position:absolute;bottom:14px;left:0;right:0;display:flex;height:68px;pointer-events:none;align-items:center}.labels text{width:25%;text-align:center;font-size:12px;font-weight:600;color:#111}.hint{font-size:12px}.actions{display:flex;gap:8px;margin:12px 0}.actions button{flex:1;font-size:12px;min-height:44px;line-height:44px;background:white;border:1px solid #ddd}.report{font-family:monospace;font-size:10px;line-height:1.8;white-space:pre-wrap;background:#ececec;padding:12px;border-radius:8px}
