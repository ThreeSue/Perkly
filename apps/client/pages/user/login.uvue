<template>
	<cl-page>
		<cl-topbar safe-area-top background-color="transparent"></cl-topbar>

		<view class="auth-content">
			<!-- 项目名称 -->
			<view class="auth-brand">
				<view class="auth-symbol"
					><cl-icon name="coupon-line" :size="36" color="primary" /></view
				><cl-text :size="25" :pt="{ className: 'font-bold mt-4' }">{{
					config.name
				}}</cl-text>
			</view>

			<!-- 登录方式 -->
			<login-phone v-if="loginMode == 'sms'" :form="form" @success="toLogin"></login-phone>
			<login-password v-else :form="form" @success="toLogin"></login-password>

			<view class="mt-2 flex flex-row justify-end">
				<cl-button text size="small" @tap="toResetPassword">{{ t("忘记密码") }}</cl-button>
				<cl-button text size="small" @tap="toggleLoginMode">
					{{ loginMode == "sms" ? t("切换为密码登录") : t("切换为短信登录") }}
				</cl-button>
			</view>

			<view class="mt-3 flex flex-row items-center justify-center">
				<cl-text color="info" :size="13">{{ t("还没有账号？") }}</cl-text>
				<cl-button text size="small" @tap="router.to('/pages/user/register')">
					{{ t("手机号注册") }}
				</cl-button>
			</view>

			<!-- 协议 -->
			<view class="mt-6 flex flex-row flex-wrap items-center justify-center">
				<cl-checkbox
					v-model="agree"
					active-icon="checkbox-circle-fill"
					inactive-icon="checkbox-blank-circle-line"
					:pt="{
						icon: {
							size: 18
						}
					}"
				>
				</cl-checkbox>
				<cl-text color="info" :size="12" @tap="agree = !agree">{{
					t("已阅读并同意")
				}}</cl-text>
				<cl-text
					:size="12"
					:pt="{
						className: 'font-bold'
					}"
					@tap.stop="toDoc(t('用户协议'), 'userAgreement')"
				>
					《{{ t("用户协议") }}》
				</cl-text>
				<cl-text color="info" :size="12">、</cl-text>
				<cl-text
					:size="12"
					:pt="{
						className: 'font-bold'
					}"
					@tap.stop="toDoc(t('隐私政策'), 'privacyPolicy')"
				>
					《{{ t("隐私政策") }}》
				</cl-text>
			</view>
			<view v-if="agreementError && !agree" class="mt-2" role="alert" aria-live="polite">
				<cl-text color="error" :size="13">
					{{ t("请先勾选并同意《用户协议》和《隐私政策》后再登录") }}
				</cl-text>
			</view>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { config } from "@/config";
import { parse, router, useStore, type Token, t } from "@/.cool";
import { provide, reactive, ref } from "vue";
import type { LoginForm } from "./types";
import { useUi } from "@/uni_modules/cool-ui";
import LoginPhone from "./components/login/phone.uvue";
import LoginPassword from "./components/login/password.uvue";

const { user } = useStore();
const ui = useUi();
const loginMode = ref<"sms" | "password">("sms");

// 表单
const form = reactive<LoginForm>({
	phone: "",
	smsCode: "",
	password: ""
});

onLoad((options) => {
	if (options?.mode === "password") loginMode.value = "password";
	const phone = String(options?.phone ?? "");
	if (/^1[3-9]\d{9}$/.test(phone)) form.phone = phone;
});

function toResetPassword() {
	router.to("/pages/user/reset-password?phone=" + (encodeURIComponent(form.phone) ?? ""));
}

// 是否同意
const agree = ref(false);
const agreementError = ref(false);

function toggleLoginMode() {
	loginMode.value = loginMode.value == "sms" ? "password" : "sms";
}

// 登录成功
async function toLogin(res: any) {
	user.setToken(parse<Token>(res)!);
	user.get();
	router.nextLogin();
}

// 跳转文档
function toDoc(name: string, path: string) {
	void path;
	ui.showToast({ message: `${name}页面尚未提供` });
}

// 是否同意
function isAgree() {
	if (!agree.value) {
		agreementError.value = true;
		ui.showToast({
			message: t("请先阅读并同意《用户协议》和《隐私政策》")
		});

		return false;
	}

	return true;
}

provide("isAgree", isAgree);
</script>

<style lang="scss" scoped>
@import "@/styles/discovery-palette.scss";
.auth-content {
	width: 100%;
	max-width: 460px;
	padding: 16px 28px 40px;
	margin: 0 auto;
	box-sizing: border-box;
}
.auth-brand {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	padding: 16px 0 36px;
}
.auth-symbol {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 64px;
	height: 64px;
	background: white;
	border: 1px solid $discovery-border;
	border-radius: 20px;
}
</style>
