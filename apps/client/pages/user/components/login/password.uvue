<template>
	<view class="flex flex-col mb-5">
		<cl-text :size="18" :pt="{ className: 'font-bold' }">{{ t("您好，欢迎登录！") }}</cl-text>
		<cl-text :pt="{ className: 'mt-2' }" color="info">
			{{ t("使用手机号和密码登录") }}
		</cl-text>
	</view>

	<view class="flex flex-col">
		<view class="mb-3 flex flex-row">
			<cl-input
				v-model="form.phone"
				type="number"
				:maxlength="11"
				prefix-icon="device-fill"
				:placeholder="t('请输入手机号')"
				:border="false"
				:disabled="loading"
				:pt="{
					className: parseClass([
						'!h-[45px] flex-1 !rounded-xl !px-4',
						[isDark, '!bg-surface-70', '!bg-white']
					]),
					prefixIcon: { className: 'mr-1' }
				}"
			></cl-input>
		</view>

		<view class="mb-5 flex flex-row">
			<cl-input
				v-model="form.password"
				password
				prefix-icon="lock-password-fill"
				:placeholder="t('请输入密码')"
				:border="false"
				:disabled="loading"
				:pt="{
					className: parseClass([
						'!h-[45px] flex-1 !rounded-xl !px-4',
						[isDark, '!bg-surface-70', '!bg-white']
					]),
					prefixIcon: { className: 'mr-1' }
				}"
			></cl-input>
		</view>

		<cl-button
			:pt="{ className: '!h-[45px] !rounded-xl' }"
			:loading="loading"
			:disabled="disabled"
			@tap="toLogin"
		>
			{{ t("登录") }}
		</cl-button>
	</view>
</template>

<script setup lang="ts">
import { computed, inject, ref, type PropType } from "vue";
import type { LoginForm } from "../../types";
import { isDark, parseClass, request, type Response, t } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";

const props = defineProps({
	form: {
		type: Object as PropType<LoginForm>,
		default: () => ({
			phone: "",
			smsCode: "",
			password: ""
		})
	}
});

const emit = defineEmits(["success"]);
const ui = useUi();
const isAgree = inject("isAgree") as () => boolean;
const loading = ref(false);

const disabled = computed(() => props.form.phone == "" || props.form.password == "");

async function toLogin() {
	if (loading.value || disabled.value) {
		return;
	}

	if (!isAgree()) {
		return;
	}

	loading.value = true;

	try {
		const res = await request({
			url: "/app/user/login/password",
			method: "POST",
			data: {
				phone: props.form.phone,
				password: props.form.password
			}
		});

		emit("success", res);
	} catch (err) {
		ui.showToast({
			message: (err as Response).message!
		});
	} finally {
		loading.value = false;
	}
}
</script>
