<template>
	<cl-page>
		<cl-topbar safe-area-top title="编辑昵称" background-color="transparent"></cl-topbar>
		<view class="p-3">
			<cl-text :size="14" :pt="{ className: 'mb-2' }">昵称</cl-text>
			<cl-input
				v-model="content"
				autofocus
				placeholder="请输入昵称"
				:disabled="saving"
			></cl-input>
		</view>
		<cl-footer>
			<cl-button
				size="large"
				:disabled="saving || content.trim() == ''"
				:loading="saving"
				@tap="save"
				>保存昵称</cl-button
			>
		</cl-footer>
	</cl-page>
</template>

<script setup lang="ts">
import { router, userInfo, useStore, type Response } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { ref } from "vue";

const ui = useUi();
const { user } = useStore();
const content = ref("");
const saving = ref(false);

async function save() {
	if (saving.value || content.value.trim() == "") return;
	saving.value = true;
	try {
		await user.update({ nickName: content.value.trim() });
		router.back();
	} catch (error) {
		ui.showToast({ message: (error as Response).message ?? "保存失败，请重试" });
	} finally {
		saving.value = false;
	}
}
onReady(() => {
	content.value = userInfo.value?.nickName ?? "";
});
</script>
