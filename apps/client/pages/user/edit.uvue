<template>
	<cl-page>
		<view class="p-3">
			<view class="flex flex-col items-center py-10 mb-3">
				<cl-avatar :src="userInfo?.avatarUrl" :size="80"></cl-avatar>
			</view>
			<cl-list>
				<cl-list-item
					label="昵称"
					hoverable
					arrow
					justify="start"
					@tap="router.to('/pages/user/edit-name')"
				>
					<cl-text>{{ userInfo?.nickName }}</cl-text>
				</cl-list-item>
				<cl-list-item label="手机号" justify="start">
					<cl-text>{{ userInfo?.phone }}</cl-text>
				</cl-list-item>
				<cl-list-item
					label="性别"
					:hoverable="!saving"
					arrow
					justify="start"
					@tap="openGender"
				>
					<cl-text>{{ saving ? "保存中…" : genderText }}</cl-text>
				</cl-list-item>
			</cl-list>
			<cl-select
				title="选择性别"
				:model-value="userInfo?.gender"
				:ref="refs.set('gender')"
				:options="genderOptions"
				:show-trigger="false"
				@change="onGenderChange"
			></cl-select>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { router, useRefs, useStore, userInfo, type Response } from "@/.cool";
import { useUi, type ClSelectOption } from "@/uni_modules/cool-ui";
import { computed, ref } from "vue";

const { user } = useStore();
const ui = useUi();
const refs = useRefs();
const saving = ref(false);
const genderOptions = ref<ClSelectOption[]>([
	{ label: "保密", value: 0 },
	{ label: "男", value: 1 },
	{ label: "女", value: 2 }
]);
const genderText = computed(() => ["保密", "男", "女"][userInfo.value?.gender ?? 0] ?? "保密");

function openGender() {
	if (!saving.value) refs.open("gender");
}
async function onGenderChange(value: number) {
	if (saving.value || value === userInfo.value?.gender) return;
	saving.value = true;
	try {
		await user.update({ gender: value });
		ui.showToast({ message: "性别已保存" });
	} catch (error) {
		ui.showToast({ message: (error as Response).message ?? "保存失败，请重试" });
	} finally {
		saving.value = false;
	}
}
</script>
