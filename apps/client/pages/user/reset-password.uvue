<template>
	<cl-page>
		<cl-topbar title="忘记密码" safe-area-top background-color="transparent" />
		<view class="px-8 pb-8">
			<view v-if="completed" class="flex flex-col items-center py-12">
				<cl-icon name="checkbox-circle-fill" color="success" :size="48" />
				<cl-text :size="22" :pt="{ className: 'mt-4 font-bold' }">密码已重设</cl-text>
				<cl-text color="info" :pt="{ className: 'mt-3 mb-6' }"
					>请使用手机号和新密码重新登录。</cl-text
				>
				<cl-button type="primary" @tap="returnToLogin">返回密码登录</cl-button>
			</view>
			<template v-else>
				<view class="flex flex-col pt-8 pb-6">
					<cl-text :size="22" :pt="{ className: 'font-bold' }"
						>通过手机号重设密码</cl-text
					>
					<cl-text color="info" :pt="{ className: 'mt-3' }"
						>验证账号绑定的手机号后，即可设置新密码。</cl-text
					>
				</view>
				<view class="mb-4 flex flex-col">
					<cl-text :pt="{ className: 'mb-2' }">手机号</cl-text>
					<cl-input
						v-model="form.phone"
						type="number"
						:maxlength="11"
						placeholder="请输入账号绑定的手机号"
						:disabled="loading"
						:pt="inputPt"
					/>
				</view>
				<view class="mb-4 flex flex-col">
					<cl-text :pt="{ className: 'mb-2' }">短信验证码</cl-text>
					<view class="flex flex-row items-center">
						<cl-input
							v-model="form.smsCode"
							type="number"
							:maxlength="6"
							placeholder="请输入6位验证码"
							:disabled="loading"
							:pt="{ className: '!h-[45px] flex-1 !rounded-xl mr-2' }"
						/>
						<sms-btn
							:phone="form.phone"
							:ready="validPhone && !loading"
							@success="smsSent = true"
						/>
					</view>
					<cl-text color="info" :size="12" :pt="{ className: 'mt-2' }"
						>获取短信前需完成图片验证。</cl-text
					>
				</view>
				<view class="mb-4 flex flex-col">
					<cl-text :pt="{ className: 'mb-2' }">新密码</cl-text>
					<cl-input
						v-model="form.password"
						password
						:maxlength="32"
						placeholder="请输入新密码"
						:disabled="loading"
						:pt="inputPt"
					/>
					<cl-text color="info" :size="12" :pt="{ className: 'mt-2' }"
						>8至32位，不含空白字符；中文等字符合计不超过72字节。</cl-text
					>
				</view>
				<view class="mb-6 flex flex-col">
					<cl-text :pt="{ className: 'mb-2' }">确认新密码</cl-text>
					<cl-input
						v-model="form.confirmPassword"
						password
						:maxlength="32"
						placeholder="请再次输入新密码"
						:disabled="loading"
						:pt="inputPt"
					/>
				</view>
				<cl-button
					type="primary"
					:loading="loading"
					:disabled="loading"
					:pt="{ className: '!h-[45px] !rounded-xl' }"
					@tap="resetPassword"
					>确认重设密码</cl-button
				>
			</template>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { computed, reactive, ref, watch } from "vue";
import { request, useStore, type Response } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import SmsBtn from "./components/sms-btn.uvue";

const { user } = useStore();
const ui = useUi();
const form = reactive({ phone: "", smsCode: "", password: "", confirmPassword: "" });
const loading = ref(false);
const smsSent = ref(false);
const completed = ref(false);
const validPhone = computed(() => /^1[3-9]\d{9}$/.test(form.phone));
const inputPt = { className: "!h-[45px] w-full !rounded-xl !px-4" };

onLoad((options) => {
	const phone = String(options?.phone ?? "");
	if (/^1[3-9]\d{9}$/.test(phone)) form.phone = phone;
});

watch(
	() => form.phone,
	() => {
		form.smsCode = "";
		smsSent.value = false;
	}
);

function passwordBytes(value: string): number {
	let bytes = 0;
	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i);
		if (code <= 0x7f) bytes++;
		else if (code <= 0x7ff) bytes += 2;
		else if (code >= 0xd800 && code <= 0xdbff && i + 1 < value.length) {
			bytes += 4;
			i++;
		} else bytes += 3;
	}
	return bytes;
}

async function resetPassword() {
	if (loading.value) return;
	let error = "";
	if (!validPhone.value) error = "请输入正确的手机号";
	else if (!smsSent.value || !/^\d{6}$/.test(form.smsCode)) error = "请先获取并填写6位短信验证码";
	else if (
		form.password.length < 8 ||
		form.password.length > 32 ||
		/\s/.test(form.password) ||
		passwordBytes(form.password) > 72
	)
		error = "密码须为8至32位，不含空白字符，且不超过72字节";
	else if (form.password !== form.confirmPassword) error = "两次输入的密码不一致";
	if (error) {
		ui.showToast({ message: error });
		return;
	}
	loading.value = true;
	try {
		await request({
			url: "/app/user/login/resetPassword",
			method: "POST",
			data: { phone: form.phone, smsCode: form.smsCode, password: form.password }
		});
		user.clear();
		form.password = "";
		form.confirmPassword = "";
		form.smsCode = "";
		completed.value = true;
	} catch (err) {
		ui.showToast({ message: (err as Response).message ?? "重设失败，请重新验证手机号后重试" });
	} finally {
		loading.value = false;
	}
}

function returnToLogin() {
	uni.redirectTo({
		url: "/pages/user/login?mode=password&phone=" + (encodeURIComponent(form.phone) ?? "")
	});
}
</script>
