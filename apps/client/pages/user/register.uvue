<template>
	<cl-page>
		<cl-topbar safe-area-top background-color="transparent"></cl-topbar>

		<view class="px-10 pb-8">
			<view class="flex flex-col items-center justify-center py-12">
				<cl-text :size="22" :pt="{ className: 'font-bold' }">券管家</cl-text>
				<cl-text color="info" :pt="{ className: 'mt-2' }">
					{{ t("手机号将作为登录账号") }}
				</cl-text>
			</view>

			<view class="mb-5 flex flex-col">
				<cl-text :size="18" :pt="{ className: 'font-bold' }">{{ t("手机号注册") }}</cl-text>
				<cl-text color="info" :pt="{ className: 'mt-2' }">
					{{ t("先设置密码，再完成图片验证和短信验证") }}
				</cl-text>
			</view>

			<view class="mb-3 flex flex-col">
				<cl-text :size="13" :pt="{ className: 'mb-2 font-medium' }">
					{{ t("手机号") }}
				</cl-text>
				<cl-input
					v-model="form.phone"
					type="number"
					:maxlength="11"
					prefix-icon="device-fill"
					:placeholder="t('请输入手机号')"
					:border="false"
					:disabled="loading"
					:pt="{
						className: parseClass([
							'!h-[45px] w-full !rounded-xl !px-4',
							[isDark, '!bg-surface-70', '!bg-white']
						]),
						prefixIcon: { className: 'mr-1' }
					}"
				></cl-input>
			</view>

			<view class="mb-3 flex flex-col">
				<cl-text :size="13" :pt="{ className: 'mb-2 font-medium' }">
					{{ t("设置密码") }}
				</cl-text>
				<cl-input
					v-model="form.password"
					password
					:maxlength="32"
					prefix-icon="lock-password-fill"
					:placeholder="t('请输入密码')"
					:border="false"
					:disabled="loading"
					:pt="{
						className: parseClass([
							'!h-[45px] w-full !rounded-xl !px-4',
							[isDark, '!bg-surface-70', '!bg-white']
						]),
						prefixIcon: { className: 'mr-1' }
					}"
				></cl-input>
			</view>

			<view class="mb-2 flex flex-col">
				<cl-text :size="13" :pt="{ className: 'mb-2 font-medium' }">
					{{ t("确认密码") }}
				</cl-text>
				<cl-input
					v-model="form.confirmPassword"
					password
					:maxlength="32"
					prefix-icon="lock-password-fill"
					:placeholder="t('请再次输入密码')"
					:border="false"
					:disabled="loading"
					:pt="{
						className: parseClass([
							'!h-[45px] w-full !rounded-xl !px-4',
							[isDark, '!bg-surface-70', '!bg-white']
						]),
						prefixIcon: { className: 'mr-1' }
					}"
				></cl-input>
				<cl-text color="info" :size="12" :pt="{ className: 'mt-2' }">
					{{ t("密码须为8至32位、不含空白字符，且UTF-8编码不超过72字节") }}
				</cl-text>
			</view>

			<view class="mt-4">
				<cl-text :size="13" :pt="{ className: 'mb-2 font-medium' }">
					{{ t("短信验证码") }}
				</cl-text>
				<view class="relative mb-2 flex flex-row items-center">
					<cl-input
						v-model="form.smsCode"
						type="number"
						:maxlength="6"
						:clearable="false"
						prefix-icon="shield-check-fill"
						:placeholder="t('请输入6位短信验证码')"
						:border="false"
						:disabled="loading"
						:pt="{
							className: parseClass([
								'!h-[45px] w-full !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: { className: 'mr-1' }
						}"
					></cl-input>
					<view class="absolute right-0">
						<sms-btn
							:phone="form.phone"
							:ready="canRequestSms"
							@success="smsSent = true"
						></sms-btn>
					</view>
				</view>
				<cl-text color="info" :size="12" v-if="smsSent">
					{{ t("短信验证码已发送，有效期5分钟") }}
				</cl-text>
				<cl-text color="info" :size="12" v-else>
					{{ t("填写正确手机号并确认密码后，点击右侧获取验证码，完成图片验证并获取短信验证码") }}
				</cl-text>
			</view>

			<view class="mt-5 flex flex-row flex-wrap items-center">
				<cl-checkbox
					v-model="agree"
					active-icon="checkbox-circle-fill"
					inactive-icon="checkbox-blank-circle-line"
					:pt="{ icon: { size: 18 } }"
				></cl-checkbox>
				<cl-text color="info" :size="12">{{ t("我已阅读并同意用户协议和隐私政策") }}</cl-text>
			</view>

			<cl-button
				:pt="{ className: '!h-[45px] !rounded-xl mt-4' }"
				:loading="loading"
				:disabled="loading"
				@tap="register"
			>
				{{ t("创建账号") }}
			</cl-button>

			<view class="mt-4 flex flex-row items-center justify-center">
				<cl-text color="info" :size="13">{{ t("已有账号？") }}</cl-text>
				<cl-button text size="small" @tap="router.to('/pages/user/login')">
					{{ t("返回短信登录") }}
				</cl-button>
			</view>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { computed, reactive, ref, watch } from "vue";
import {
	isDark,
	parse,
	parseClass,
	request,
	router,
	useStore,
	type Response,
	type Token,
	t
} from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import SmsBtn from "./components/sms-btn.uvue";

const { user } = useStore();
const ui = useUi();

const form = reactive({
	phone: "",
	password: "",
	confirmPassword: "",
	smsCode: ""
});

const agree = ref(false);
const smsSent = ref(false);
const loading = ref(false);

function isValidPhone(phone: string) {
	return /^1[3-9]\d{9}$/.test(phone);
}

function utf8ByteLength(value: string) {
	let bytes = 0;

	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i);

		if (code <= 0x7f) {
			bytes += 1;
		} else if (code <= 0x7ff) {
			bytes += 2;
		} else if (code >= 0xd800 && code <= 0xdbff && i + 1 < value.length) {
			bytes += 4;
			i++;
		} else {
			bytes += 3;
		}
	}

	return bytes;
}

const hasValidPassword = computed(() => {
	return (
		form.password.length >= 8 &&
		form.password.length <= 32 &&
		!/\s/.test(form.password) &&
		utf8ByteLength(form.password) <= 72
	);
});

const canRequestSms = computed(() => {
	return (
		isValidPhone(form.phone) &&
		hasValidPassword.value &&
		form.confirmPassword == form.password
	);
});

watch(
	() => form.phone,
	() => {
		form.smsCode = "";
		smsSent.value = false;
	}
);

function showError(message: string) {
	ui.showToast({ message: t(message) });
}

function validateForm() {
	if (!isValidPhone(form.phone)) {
		showError("请填写正确的手机号");
		return false;
	}

	if (
		form.password.length < 8 ||
		form.password.length > 32 ||
		/\s/.test(form.password)
	) {
		showError("密码须为8至32位且不含空白字符");
		return false;
	}

	if (utf8ByteLength(form.password) > 72) {
		showError("密码的UTF-8编码不能超过72字节");
		return false;
	}

	if (form.confirmPassword == "") {
		showError("请再次输入密码");
		return false;
	}

	if (form.password != form.confirmPassword) {
		showError("两次输入的密码不一致");
		return false;
	}

	if (!smsSent.value) {
		showError("请先完成图片验证并获取短信验证码");
		return false;
	}

	if (!/^\d{6}$/.test(form.smsCode)) {
		showError("请输入6位短信验证码");
		return false;
	}

	if (!agree.value) {
		showError("请先阅读并同意用户协议和隐私政策");
		return false;
	}

	return true;
}

async function register() {
	if (loading.value || !validateForm()) {
		return;
	}

	loading.value = true;

	try {
		const res = await request({
			url: "/app/user/login/register",
			method: "POST",
			data: {
				phone: form.phone,
				smsCode: form.smsCode,
				password: form.password
			}
		});

		const token = parse<Token>(res);
		if (token == null) {
			showError("注册失败，请检查后重试");
			return;
		}

		user.setToken(token);
		await user.get();
		router.nextLogin();
	} catch (err) {
		const message = (err as Response).message ?? "注册失败，请检查后重试";
		showError(message);
	} finally {
		loading.value = false;
	}
}
</script>
