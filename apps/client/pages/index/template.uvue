<template>
	<cl-page>
		<cl-topbar
			:show-back="false"
			safe-area-top
			title="我的券"
			:background-color="isDark ? '#191919' : '#eef2f6'"
		/>
		<view class="trade-page" :class="{ 'is-dark': isDark }"
			><view class="trade-content">
				<view class="trade-row"
					><text class="trade-title">我的券包</text
					><cl-button size="small" border @tap="router.to('/pages/trade/orders')"
						>我的订单</cl-button
					></view
				>
				<view class="trade-tabs"
					><button
						v-for="tab in tabs"
						:key="tab.value"
						class="trade-filter"
						:class="{ 'is-active': state === tab.value }"
						:aria-pressed="state === tab.value"
						@tap="select(tab.value)"
					>
						{{ tab.label }}
					</button></view
				>
				<client-trade-state
					:logged-in="loggedIn"
					:loading="loading && items.length === 0"
					:error="error"
					:empty="items.length === 0"
					empty-text="当前分类暂无优惠券，去首页看看吧"
					@retry="load(items.length === 0)"
				/>
				<navigator
					v-for="coupon in items"
					:key="String(coupon.id)"
					class="trade-card"
					:url="'/pages/trade/wallet?id=' + encodeURIComponent(String(coupon.id))"
				>
					<view class="trade-row"
						><text class="trade-title">{{ coupon.name }}</text
						><text class="trade-status">{{ coupon.stateText }}</text></view
					>
					<text class="trade-body trade-muted">{{ coupon.merchantName }}</text
					><text class="trade-body">{{ coupon.validFrom }} 至 {{ coupon.validTo }}</text>
					<text class="trade-body trade-muted">{{
						coupon.state === "UNUSED" ? "查看券码与使用规则 ›" : "查看持券详情 ›"
					}}</text>
				</navigator>
				<view v-if="loggedIn" class="trade-actions"
					><cl-button border :disabled="loading" @tap="load(true)">刷新券包</cl-button
					><cl-button
						v-if="hasMore"
						:loading="loading"
						:disabled="loading"
						@tap="load(false)"
						>加载更多</cl-button
					></view
				>
			</view></view
		>
	</cl-page>
</template>
<script setup lang="ts">
import { ref } from "vue";
import { isDark, router } from "@/.cool";
import ClientTradeState from "@/components/client-trade-state.uvue";
import { usePrivatePage } from "@/composables/use-private-page";
import { listWallet } from "@/api/trade";
import type { WalletCoupon, WalletState } from "@/types/trade";
const state = ref<WalletState | "">("UNUSED");
const tabs: { value: WalletState | ""; label: string }[] = [
	{ value: "UNUSED", label: "待使用" },
	{ value: "NOT_STARTED", label: "未生效" },
	{ value: "USED", label: "已使用" },
	{ value: "EXPIRED", label: "已过期" },
	{ value: "VOID", label: "已作废" },
	{ value: "", label: "全部" }
];
const { items, loading, error, loggedIn, hasMore, load, clear } = usePrivatePage<WalletCoupon>(
	(page) => listWallet(page, state.value || undefined)
);
function select(value: WalletState | "") {
	state.value = value;
	load(true);
}
onShow(() => load(true));
onHide(clear);
</script>
<style lang="scss" scoped>
@import "@/styles/trade.scss";
</style>
