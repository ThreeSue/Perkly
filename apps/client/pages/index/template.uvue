<template>
	<cl-page>
		<cl-sticky>
			<cl-topbar fixed safe-area-top :title="`${$t('购物车 ({num})', { num: totalCount })}`">
				<template #prepend>
					<!-- #ifdef MP -->
					<cl-text
						:pt="{
							className: 'ml-1'
						}"
						@tap="isDel = !isDel"
					>
						{{ isDel ? t("完成") : t("管理") }}
					</cl-text>
					<!-- #endif -->
				</template>

				<template #append>
					<!-- #ifndef MP -->
					<cl-text
						:pt="{
							className: 'mr-3'
						}"
						@tap="isDel = !isDel"
					>
						{{ isDel ? t("完成") : t("管理") }}
					</cl-text>
					<!-- #endif -->
				</template>
			</cl-topbar>
		</cl-sticky>

		<view class="p-3">
			<view class="p-3 rounded-xl bg-white dark:!bg-surface-800 mb-3">
				<cl-text>主页和商品详情页加入的商品会显示在这里</cl-text>
			</view>

			<cl-list-item
				v-for="(item, index) in list"
				:key="item.product.id"
				:pt="{
					className: parseClass([
						'rounded-2xl ',
						[index == list.length - 1, 'mb-0', 'mb-3']
					]),
					inner: {
						className: '!p-4'
					}
				}"
				swipeable
			>
				<view class="flex flex-row flex-1">
					<view class="flex flex-col mr-4 pt-[28px]" @tap="selectItem(item)">
						<cl-icon
							name="checkbox-circle-line"
							color="primary"
							:size="20"
							v-if="item.checked"
						></cl-icon>
						<cl-icon name="checkbox-blank-circle-line" :size="20" v-else></cl-icon>
					</view>

					<cl-image :width="76" :height="76" :src="item.product.image"></cl-image>

					<view class="flex flex-col ml-3 flex-1">
						<cl-text
							:pt="{
								className: 'mb-2 font-bold'
							}"
							>{{ item.product.name }}</cl-text
						>

						<view class="flex flex-row mb-2">
							<view
								class="bg-surface-100 dark:!bg-surface-700 rounded-md py-1 px-2 flex flex-row items-center"
							>
								<cl-text :size="12">{{ item.product.unit }}</cl-text>
								<cl-icon
									name="arrow-down-s-line"
									:pt="{ className: 'ml-1' }"
								></cl-icon>
							</view>
						</view>

						<view class="flex flex-row items-center mb-2">
							<cl-text
								:size="11"
								:pt="{
									className: 'text-red-500 mr-[1px]'
								}"
								>¥</cl-text
							>
							<cl-text
								:size="16"
								:pt="{
									className: 'text-red-500 mr-auto'
								}"
							>{{ item.product.price }}</cl-text
							>

							<view
								v-if="isDel"
								class="p-1 bg-red-500 rounded-lg"
								@tap="delItem(index)"
							>
								<cl-icon name="delete-bin-line" color="white"></cl-icon>
							</view>

							<view class="flex" v-else>
								<cl-input-number
									v-model="item.quantity"
									:size="20"
									:min="1"
									@change="updateQuantity(item, $event)"
									:pt="{
										op: {
											plus: {
												className: '!rounded-full'
											},
											minus: {
												className: '!rounded-full'
											},
											icon: {
												size: 14
											}
										},
										value: {
											className: '!w-[30px] rounded-full !px-0',
											input: {
												className: '!text-[12px]'
											}
										}
									}"
								></cl-input-number>
							</view>
						</view>

						<cl-text :size="11" color="info" :pt="{ className: 'mb-1' }">
							{{ item.product.offer }}
						</cl-text>
						<cl-text :size="11">{{ item.product.address }}</cl-text>
					</view>
				</view>

				<template #swipe-right>
					<cl-button
						type="error"
						:pt="{
							className: '!rounded-none h-full w-[80px]'
						}"
						@tap="delItem(index)"
						>{{ t("删除") }}</cl-button
					>
				</template>
			</cl-list-item>

			<cl-empty v-if="list.length == 0"></cl-empty>
		</view>

		<cl-footer :pt="{ wrapper: { className: '!bottom-[60px]' } }">
			<view class="flex flex-row items-center h-[35px]">
				<cl-checkbox
					active-icon="checkbox-circle-line"
					inactive-icon="checkbox-blank-circle-line"
					:pt="{
						className: 'mr-auto'
					}"
					:size="14"
					v-model="selectAll"
					@change="onSelectAllChange"
					>{{ t("全选") }}</cl-checkbox
				>

				<template v-if="isDel">
					<cl-button
						type="error"
						:pt="{
							className: '!px-5'
						}"
						@tap="delAll"
					>
						{{ t("删除") }}
					</cl-button>
				</template>

				<template v-else>
					<view class="flex flex-col mr-3 items-end pt-1">
						<cl-text :size="12" color="info">{{ t("合计") }}</cl-text>
						<cl-text color="error" :value="totalPrice" type="amount"></cl-text>
					</view>

					<cl-button
						type="error"
						:pt="{
							className: '!px-8'
						}"
						@tap="toSettle"
					>
						{{ t("去结算") }}
					</cl-button>
				</template>
			</view>
		</cl-footer>

		<view class="h-[60px]"></view>
		<custom-tabbar></custom-tabbar>
	</cl-page>
</template>

<script lang="ts" setup>
import { parseClass, isEmpty, $t, t } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { computed, ref } from "vue";
import { onShow } from "@dcloudio/uni-app";
import { getCartItems, removeFromCart, setCartQuantity, type CartItem } from "@/api/cart";
import CustomTabbar from "./components/tabbar.uvue";

const ui = useUi();

type CartLine = CartItem & { checked: boolean };

// 页面展示共享购物车数据，勾选状态仅保留在当前页面。
const list = ref<CartLine[]>([]);
const selectAll = ref(false);

function refreshCart() {
	const previousSelection = list.value.map((item) => ({
		id: item.product.id,
		checked: item.checked
	}));

	list.value = getCartItems().map((item) => {
		const previous = previousSelection.find((entry) => entry.id == item.product.id);
		return { ...item, checked: previous?.checked ?? true };
	});
	selectAll.value = list.value.length > 0 && list.value.every((item) => item.checked);
}

onShow(refreshCart);

function updateQuantity(item: CartLine, quantity: number) {
	item.quantity = quantity;
	setCartQuantity(item.product.id, quantity);
}

/**
 * 选择/取消选择单个商品
 * @param item 需要操作的商品
 */
function selectItem(item: CartLine) {
	// 切换选中状态
	item.checked = !item.checked;
	// 判断是否所有商品都被选中，更新全选状态
	selectAll.value = list.value.every((item) => item.checked);
}

/**
 * 全选/取消全选
 * @param val 是否全选
 */
function onSelectAllChange(val: boolean) {
	list.value.forEach((item, index, arr) => {
		// item.checked = val; // 这样写，在 android 上无效
		arr[index].checked = val;
	});
}

// 是否处于删除模式
const isDel = ref(false);

/**
 * 删除单个商品
 * @param index 商品索引
 */
function delItem(index: number) {
	ui.showConfirm({
		title: t("温馨提示"),
		message: t("确定删除该商品吗？"),
		callback(action) {
			if (action === "confirm") {
				const item = list.value[index];
				if (item != null) {
					removeFromCart(item.product.id);
				}
				// 删除指定索引的商品
				list.value.splice(index, 1);
				selectAll.value = list.value.length > 0 && list.value.every((item) => item.checked);

				ui.showToast({
					message: t("删除成功")
				});
			}
		}
	});
}

/**
 * 删除所有已选中的商品
 */
function delAll() {
	const checked = list.value.filter((item) => item.checked);

	// 如果没有选中商品，提示用户
	if (isEmpty(checked)) {
		return ui.showToast({
			message: t("请先选择商品")
		});
	}

	ui.showConfirm({
		title: t("温馨提示"),
		message: t("确定删除选中的商品吗？"),
		callback(action) {
			if (action == "confirm") {
				checked.forEach((item) => removeFromCart(item.product.id));
				// 只保留未选中的商品
				list.value = list.value.filter((item) => !item.checked);

				// 如果之前是全选，删除后取消全选状态
				if (selectAll.value) {
					selectAll.value = false;
				}

				ui.showToast({
					message: t("删除成功")
				});
			}
		}
	});
}

/**
 * 计算已选中商品的总价
 */
const totalPrice = computed(() => {
	return list.value
		.filter((item) => item.checked)
		.reduce((acc, item) => acc + (Number(item.product.price) || 0) * item.quantity, 0);
});

const totalCount = computed(() => {
	return list.value.reduce((acc, item) => acc + item.quantity, 0);
});

/**
 * 结算操作
 */
function toSettle() {
	// 如果没有选中商品，提示用户
	if (totalPrice.value <= 0) {
		return ui.showToast({
			message: t("请先选择商品")
		});
	}

	ui.showConfirm({
		title: t("温馨提示"),
		message: $t("您需支付 {price} 元，请确认支付", { price: totalPrice.value }),
		beforeClose(action, { showLoading, close }) {
			if (action == "confirm") {
				showLoading();

				setTimeout(() => {
					ui.showToast({
						message: t("支付成功")
					});

					close();
				}, 1000);
			} else {
				close();
			}
		}
	});
}
</script>
