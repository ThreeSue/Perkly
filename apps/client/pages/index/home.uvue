	width: 100%;
	box-sizing: border-box;
	max-width: $discovery-width;
	margin: 0 auto;
	padding: 12px 20px 0;
}
.home-brand-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	margin-bottom: 22px;
}
.home-brand {
	display: block;
	font-size: 24px;
	line-height: 1.4;
	font-weight: 800;
	letter-spacing: 1px;
}
.home-brand-dot {
	color: $discovery-primary;
	margin-left: 3px;
}
.home-brand-note {
	display: block;
	font-size: 12px;
	color: $discovery-muted;
	margin-top: 4px;
}
.home-location {
	margin: 0;
	max-width: 48%;
}
.home-location-arrow {
	margin-left: 4px;
}
.home-services-inner {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 22px 0 20px;
	border-bottom: 1px solid $discovery-border;
}
.home-service {
	width: 25%;
	min-width: 0;
}
.home-service-button {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10px;
	margin: 0;
	padding: 0 2px;
	background: transparent;
	border-radius: 14px;
	color: $discovery-ink;
	font-size: 13px;
	font-weight: 600;
	line-height: 1.6;
}
.home-service-button::after {
	border: 0;
}
.home-service-label {
	font-size: 13px;
	white-space: nowrap;
}
.home-service-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 52px;
	height: 52px;
	background: white;
	border: 1px solid rgba(255, 255, 255, 0.9);
	border-radius: 18px;
	color: $discovery-strong;
	box-shadow: inset 0 -2px 0 rgba(82, 109, 136, 0.07);
}
.home-content {
	padding-top: 20px;
}
.section-note {
	display: block;
	font-size: 12px;
	color: $discovery-muted;
	margin-top: 5px;
}
.coupon-section-head {
	margin-top: 30px;
}
.coupon-grid {
	display: flex;
	flex-direction: column;
	gap: 12px;
}
.coupon-cell {
	width: 100%;
}
.is-dark .home-service-icon {
	background: $discovery-dark-surface;
	color: $discovery-dark-primary;
	border-color: $discovery-dark-border;
}
.is-dark .home-service-button {
	color: $discovery-dark-ink;
}
.is-dark .home-brand-note,
.is-dark .section-note {
	color: $discovery-dark-muted;
}
.is-dark .home-services-inner {
	border-color: $discovery-dark-border;
}
// #ifdef H5
.home-service-button:hover .home-service-icon {
	background: $discovery-soft;
}
.home-service-button:active .home-service-icon {
	transform: scale(0.94);
}
