.home-page {
	padding-bottom: 24px;
}
.coupon-section-head {
	margin-top: 24px;
}
.coupon-grid {
	display: flex;
	flex-direction: column;
	gap: 10px;
}
.coupon-cell {
	width: 100%;
}
.home-header {
	background: $discovery-bg;
}
.home-header-inner {
	width: 100%;
	box-sizing: border-box;
	max-width: 680px;
	margin: 0 auto;
	padding: 10px 16px 18px;
}
.home-brand-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 16px;
}
.home-brand {
	font-size: 23px;
	font-weight: 800;
	letter-spacing: 1px;
}
.home-location {
	margin: 0;
	max-width: 62%;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-size: 13px;
}
.home-services {
	background: $discovery-bg;
	margin-top: 0;
	position: relative;
}
.home-services-inner {
	width: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	max-width: 680px;
	margin: 0 auto;
	padding: 8px 16px 22px;
}
.home-service {
	width: calc(25% - 9px);
	min-width: 0;
}
.home-service-button {
	width: 100%;
	height: 64px;
	margin: 0;
	font-size: 14px;
	font-weight: 600;
	white-space: nowrap;
	background: #ffffff;
	color: $discovery-ink;
	border: 1px solid $discovery-border;
	border-radius: 12px;
	padding: 0;
	line-height: 64px;
}
.home-service-button::after {
	border: 0;
}
</style>
