<template>
	<cl-page :back-top="false">
		<view class="discovery-page home-page" :class="{ 'is-dark': isDark }">
			<view class="home-header">
				<cl-topbar
					:show-back="false"
					safe-area-top
					:height="isMp() ? 32 : 8"
					:background-color="isDark ? '#191919' : '#eef2f6'"
					><view
				/></cl-topbar>
				<view class="home-header-inner">
					<view class="home-brand-row">
						<text class="home-brand">券管家</text>
						<cl-button
							class="home-location"
							type="light"
							rounded
							icon="map-pin-line"
							size="normal"
							:pt="{
								label: { color: isDark ? '#f1f5f9' : '#26313b' },
								icon: { color: isDark ? '#abc6e3' : '#526d88', size: 15 }
							}"
							:style="{
								backgroundColor: isDark ? '#262629' : '#ffffff',
								borderColor: isDark ? '#41414a' : '#dce4ec'
							}"
							:disabled="selectingLocation"
							@tap="choosePlace"
						>
							{{ place || "选择地点" }} ▾
						</cl-button>
					</view>
					<client-search v-model="keyword" @submit="search" />
				</view>
			</view>
			<view class="home-services"
				><view class="home-services-inner">
					<navigator
					v-for="service in homeServices"
					:key="service.id"
						class="home-service"
					:url="service.id === 'group-buy' ? '/pages/discover/coupons' : '/pages/discover/list'"
					>
					<button class="home-service-button">{{ service.name }}</button>
					</navigator>
				</view></view
			>
			<view class="discovery-content">
				<view class="discovery-section-head">
					<view><text class="discovery-heading">发现好店</text></view>
					<navigator class="discovery-link" url="/pages/discover/list"
						>查看全部 ›</navigator
					>
				</view>
				<view v-if="loading" class="discovery-state" role="status"
					><text>门店加载中…</text></view
				>
				<view v-else-if="error" class="discovery-state"
					><text>{{ error }}</text
					><button @tap="loadStores">重试</button></view
				>
				<view v-else-if="stores.length === 0" class="discovery-state"
					><text>暂无可展示门店</text></view
				>
				<view v-else class="discovery-grid"
					><view v-for="store in stores" :key="String(store.id)" class="discovery-cell"
						><client-merchant-card :store="store" /></view
				></view>
				<view class="discovery-section-head coupon-section-head">
					<view><text class="discovery-heading">优惠券</text></view>
					<navigator class="discovery-link" url="/pages/discover/coupons"
						>查看全部 ›</navigator
					>
				</view>
				<view v-if="couponLoading" class="discovery-state" role="status">
					<text>优惠券加载中…</text>
				</view>
				<view v-else-if="couponError" class="discovery-state">
					<text>{{ couponError }}</text>
					<button @tap="loadCoupons">重试</button>
				</view>
				<view v-else-if="coupons.length === 0" class="discovery-state">
					<text>暂无可展示优惠券</text>
				</view>
				<view v-else class="coupon-grid">
					<view v-for="coupon in coupons" :key="String(coupon.id)" class="coupon-cell">
						<client-coupon-card :coupon="coupon" />
					</view>
				</view>
			</view>
		</view>
	</cl-page>
</template>
<script setup lang="ts">
import { ref, onUnmounted } from "vue";
import { isDark, isH5, isMp } from "@/.cool";
import { getApiErrorMessage, listCoupons, listStores } from "@/api/discovery";
import type { Coupon, Store } from "@/types/discovery";
import ClientSearch from "@/components/client-search.uvue";
import ClientMerchantCard from "@/components/client-merchant-card.uvue";
import ClientCouponCard from "@/components/client-coupon-card.uvue";
const homeServices = [
	{ id: "takeaway", name: "外卖" },
	{ id: "group-buy", name: "团购" },
	{ id: "shows", name: "电影演出" },
	{ id: "stays", name: "民宿" }
];
const keyword = ref("");
const place = ref("");
const selectingLocation = ref(false);
const stores = ref<Store[]>([]);
const coupons = ref<Coupon[]>([]);
const loading = ref(false);
const error = ref("");
const couponLoading = ref(false);
const couponError = ref("");
let storeRequestId = 0;
let couponRequestId = 0;
async function loadStores() {
	const id = ++storeRequestId;
	loading.value = true;
	error.value = "";
	try {
		const result = await listStores({ page: 1, size: 4 });
		if (id === storeRequestId) stores.value = result.list;
	} catch (err) {
		if (id === storeRequestId) {
			error.value = getApiErrorMessage(err, "门店加载失败，请重试");
		}
	} finally {
		if (id === storeRequestId) loading.value = false;
	}
}
async function loadCoupons() {
	const id = ++couponRequestId;
	couponLoading.value = true;
	couponError.value = "";
	try {
		const result = await listCoupons({ page: 1, size: 4 });
		if (id === couponRequestId) coupons.value = result.list;
	} catch (err) {
		if (id === couponRequestId) {
			couponError.value = getApiErrorMessage(err, "优惠券加载失败，请重试");
		}
	} finally {
		if (id === couponRequestId) couponLoading.value = false;
	}
}
function load() {
	loadStores();
	loadCoupons();
}
function search() {
	uni.hideKeyboard();
	uni.navigateTo({
		url: "/pages/discover/list?keyword=" + encodeURIComponent(keyword.value.trim())
	});
}
function choosePlace() {
	if (selectingLocation.value) return;
	if (isH5()) {
		uni.showToast({
			title: "H5预览未配置地图服务，请在微信小程序中选址",
			icon: "none"
		});
		return;
	}
	selectingLocation.value = true;
	uni.chooseLocation({
		success(result) {
			place.value = result.name || result.address || "已选地点";
		},
		fail(error) {
			if ((error.errMsg ?? "").toLowerCase().includes("cancel")) return;
			uni.showToast({
				title: isMp() ? "请检查小程序定位权限" : "请在微信小程序中选择地点",
				icon: "none"
			});
		},
		complete() {
			selectingLocation.value = false;
		}
	});
}
onShow(load);
onUnmounted(() => {
	storeRequestId++;
	couponRequestId++;
});
</script>
<style lang="scss" scoped>
