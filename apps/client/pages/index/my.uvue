<template>
	<cl-page :back-top="false">
		<cl-topbar
			:height="44"
			:show-back="false"
			safe-area-top
			title="我的"
			:background-color="isDark ? '#191919' : '#eef2f6'"
		/>
		<view class="profile-page" :class="{ 'is-dark': isDark }">
			<view class="profile-card">
				<cl-avatar
					:src="userInfo?.avatarUrl"
					:size="64"
					:pt="{ className: '!rounded-3xl', icon: { size: 28 } }"
				/>
				<view class="profile-info">
					<text class="profile-name">{{
						userInfo?.nickName || (user.token == null ? "欢迎来到券管家" : "账户资料")
					}}</text>
					<text v-if="!user.isNull()" class="profile-caption">{{
						userInfo?.phone || ""
					}}</text>
					<text v-else-if="user.token != null" class="profile-caption">{{
						profileLoading
							? "正在读取账户资料…"
							: profileLoadFailed
								? "资料暂时无法加载"
								: "正在读取账户资料"
					}}</text>
					<text v-else class="profile-caption">登录后，收好每一份优惠</text>
					<cl-button
						v-if="user.token == null"
						class="profile-login"
						size="small"
						type="primary"
						@tap="toLogin"
						>登录 / 注册 <cl-icon name="arrow-right-line" :size="15" color="#ffffff"
					/></cl-button>
					<cl-button
						v-else-if="user.isNull() && profileLoadFailed"
						class="profile-login"
						size="small"
						:disabled="profileLoading"
						@tap="reloadProfile"
						>重试</cl-button
					>
				</view>
			</view>
			<button
				class="profile-wallet"
				role="button"
				tabindex="0"
				@tap="openWallet"
				@keydown="keyWallet"
			>
				<view class="profile-wallet-copy"
					><text class="profile-wallet-kicker">我的优惠券</text
					><text class="profile-wallet-title">好优惠，随身带</text
					><text class="profile-wallet-note">查看券码与有效期</text></view
				>
				<view class="profile-wallet-symbol" aria-hidden="true"
					><cl-icon name="coupon-line" :size="40" color="#d6e3ee" /></view
				><cl-icon name="arrow-right-up-line" :size="22" color="#ffffff" />
			</button>
			<view class="profile-menu">
				<navigator class="profile-menu-row" url="/pages/trade/orders"
					><view class="profile-menu-icon"
						><cl-icon name="file-list-line" :size="22" /></view
					><view class="profile-menu-copy"
						><text class="profile-menu-label">我的订单</text
						><text class="profile-caption">购券进度与订单明细</text></view
					><cl-icon name="arrow-right-s-line" :size="20" color="info"
				/></navigator>
				<button v-if="!user.isNull()" class="profile-menu-row" @tap="toEdit">
					<view class="profile-menu-icon"><cl-icon name="user-line" :size="22" /></view
					><view class="profile-menu-copy"
						><text class="profile-menu-label">个人资料</text
						><text class="profile-caption">昵称、头像与性别</text></view
					><cl-icon name="arrow-right-s-line" :size="20" color="info" />
				</button>
				<button v-if="!user.isNull()" class="profile-menu-row" @tap="toSet">
					<view class="profile-menu-icon"
						><cl-icon name="settings-line" :size="22" /></view
					><view class="profile-menu-copy"
						><text class="profile-menu-label">设置</text
						><text class="profile-caption">账户与登录管理</text></view
					><cl-icon name="arrow-right-s-line" :size="20" color="info" />
				</button>
			</view>
			<text class="profile-footer">券管家 · 让优惠融入日常</text>
		</view>
		<client-floating-nav active="my" />
	</cl-page>
</template>
<script setup lang="ts">
import { isDark, router, userInfo, useStore } from "@/.cool";
import ClientFloatingNav from "@/components/client-floating-nav.uvue";

const { user } = useStore();
const profileLoading = user.profileLoading;
const profileLoadFailed = user.profileLoadFailed;

function keyWallet(event: KeyboardEvent) {
	// #ifdef H5
	if (event.key === "Enter" || event.key === " ") {
		event.preventDefault();
		openWallet();
	}
	// #endif
}
function openWallet() {
	uni.switchTab({ url: "/pages/index/template" });
}

function toLogin() {
	router.to("/pages/user/login");
}

function toSet() {
	router.to("/pages/set/index");
}

function toEdit() {
	router.to("/pages/user/edit");
}

function reloadProfile() {
	user.get();
}

onReady(() => {
	user.get();
});
</script>

<style lang="scss" scoped>
@import "@/styles/discovery-palette.scss";
.profile-page {
	max-width: $discovery-width;
	margin: 0 auto;
	padding: 12px 20px 0;
	box-sizing: border-box;
	width: 100%;
}
