<template>
	<cl-page>
		<cl-topbar
			fixed
			:height="44"
			:show-back="false"
			safe-area-top
			title="我的"
			:background-color="isDark ? '#191919' : '#eef2f6'"
		>
		</cl-topbar>

		<view class="profile-card" :class="{ 'is-dark': isDark }">
			<cl-avatar
				:src="userInfo?.avatarUrl"
				:size="76"
				:pt="{ className: '!rounded-3xl', icon: { size: 30 } }"
			></cl-avatar>
			<view class="profile-info">
				<cl-text :size="18" :pt="{ className: 'font-bold' }">
					{{ userInfo?.nickName || (user.token == null ? "欢迎使用券管家" : "账户资料") }}
				</cl-text>
				<cl-text v-if="!user.isNull()" color="info" :size="12" :pt="{ className: 'mt-1' }">
					{{ userInfo?.phone || "" }}
				</cl-text>
				<cl-text
					v-else-if="user.token != null"
					color="info"
					:size="12"
					:pt="{ className: 'mt-1' }"
				>
					{{
						profileLoading
							? "正在从服务端读取资料…"
							: profileLoadFailed
								? "资料暂时无法加载"
								: "正在读取账户资料"
					}}
				</cl-text>
				<cl-button
					v-if="user.token == null"
					class="mt-3"
					size="small"
					type="primary"
					@tap="toLogin"
				>
					登录 / 注册
				</cl-button>
				<cl-button
					v-else-if="user.isNull() && profileLoadFailed"
					class="mt-3"
					size="small"
					:disabled="profileLoading"
					@tap="reloadProfile"
				>
					重试
				</cl-button>
			</view>
		</view>

		<cl-list v-if="!user.isNull()" :pt="{ className: 'mx-4' }">
			<cl-list-item label="个人资料" icon="user-line" arrow hoverable @tap="toEdit">
			</cl-list-item>
			<cl-list-item label="设置" icon="settings-line" arrow hoverable @tap="toSet">
			</cl-list-item>
		</cl-list>

		<custom-tabbar></custom-tabbar>
	</cl-page>
</template>

<script setup lang="ts">
import { isDark, router, userInfo, useStore } from "@/.cool";
import CustomTabbar from "./components/tabbar.uvue";

const { user } = useStore();
const profileLoading = user.profileLoading;
const profileLoadFailed = user.profileLoadFailed;

function toLogin() {
	router.to("/pages/user/login");
}

function toSet() {
	router.to("/pages/set/index");
}

function toEdit() {
	router.to("/pages/user/edit");
}

function reloadProfile() {
	user.get();
}

onReady(() => {
	user.get();
});
</script>

<style lang="scss" scoped>
@import "@/styles/discovery-palette.scss";
.profile-card.is-dark {
	background: $discovery-dark-surface;
}
.profile-card {
	margin: 20px 16px 16px;
	padding: 24px 20px;
	border-radius: 18px;
	background: #fff;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.profile-info {
	margin-left: 16px;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}
</style>
