	display: flex;
	flex-direction: column;
	align-items: flex-start;
	min-width: 0;
	flex: 1;
}
.profile-name {
	font-size: 21px;
	font-weight: 700;
	line-height: 1.5;
	overflow-wrap: anywhere;
}
.profile-caption {
	display: block;
	font-size: 13px;
	line-height: 1.7;
	color: $discovery-muted;
	margin-top: 4px;
}
.profile-login {
	margin-top: 12px;
}
.profile-wallet {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	gap: 12px;
	width: 100%;
	padding: 24px;
	margin: 0 0 24px;
	border-radius: 22px;
	background: $discovery-strong;
	color: white;
	text-align: left;
	line-height: 1.5;
	box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.3);
}
.profile-wallet::after {
	border: 0;
}
.profile-wallet-copy {
	flex: 1;
	min-width: 0;
}
.profile-wallet-kicker,
.profile-wallet-note {
	display: block;
	font-size: 12px;
	color: #d6e3ee;
}
.profile-wallet-title {
	display: block;
	font-size: 21px;
	font-weight: 650;
	margin: 8px 0;
}
.profile-wallet-symbol {
	color: #d6e3ee;
	transform: rotate(-16deg);
}
.profile-menu {
	background: white;
	border-radius: $discovery-radius;
	padding: 0 20px;
}
.profile-menu-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14px;
	min-height: 84px;
	box-sizing: border-box;
	padding: 16px 0;
	margin: 0;
	width: 100%;
	background: transparent;
	color: $discovery-ink;
	border-radius: 0;
	text-align: left;
	border-bottom: 1px solid $discovery-border;
	line-height: 1.5;
}
.profile-menu-row:last-child {
	border-bottom: 0;
}
.profile-menu-row::after {
	border: 0;
}
.profile-menu-icon {
	color: $discovery-primary;
}
.profile-menu-copy {
	flex: 1;
	min-width: 0;
}
.profile-menu-label {
	font-size: 15px;
	font-weight: 600;
}
.profile-footer {
	display: block;
	text-align: center;
	font-size: 12px;
	color: $discovery-muted;
	margin: 32px 0 16px;
}
.is-dark .profile-name,
.is-dark .profile-menu-row {
	color: $discovery-dark-ink;
}
.is-dark .profile-menu {
	background: $discovery-dark-surface;
}
.is-dark .profile-caption,
.is-dark .profile-footer {
	color: $discovery-dark-muted;
}
.is-dark .profile-menu-row {
	border-color: $discovery-dark-border;
}
// #ifdef H5
.profile-wallet:hover {
	background: $discovery-primary;
}
.profile-menu-row:hover {
	color: $discovery-primary;
}
