<template>
	<cl-page>
		<view class="p-3">
			<cl-list>
				<cl-list-item hoverable justify="center" @tap="toLogout">
					<cl-text color="error">退出登录</cl-text>
				</cl-list-item>
			</cl-list>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { useStore } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";

const ui = useUi();
const { user } = useStore();

function toLogout() {
	ui.showConfirm({
		title: "退出登录",
		message: "退出后，查看个人资料和我的券需要重新登录。",
		callback(action) {
			if (action == "confirm") user.logout();
		}
	});
}
</script>
