<template>
	<cl-page :back-top="false">
		<view class="discovery-page" :class="{ 'is-dark': isDark }">
			<view class="discovery-content">
				<view v-if="loading" class="discovery-state" role="status">
					<text>优惠券详情加载中…</text>
				</view>
				<view v-else-if="error" class="discovery-state">
					<text>{{ error }}</text>
					<button class="discovery-action discovery-retry" @tap="load">重试</button>
				</view>
				<template v-else-if="coupon">
					<view class="coupon-detail-card">
						<image
							v-if="coupon.cover && !imageFailed"
							class="coupon-detail-image"
							:src="coupon.cover"
							mode="aspectFill"
							@error="imageFailed = true"
						/>
						<view v-else class="coupon-detail-image coupon-detail-image-fallback">
							<text>{{ coupon.typeText }}</text>
						</view>
						<text class="discovery-detail-title">{{ coupon.name }}</text>
						<text class="discovery-caption"
							>{{ coupon.merchantName }} · {{ coupon.categoryName }}</text
						>
						<view class="coupon-price-row">
							<text class="coupon-price">¥{{ formatMoney(coupon.salePrice) }}</text>
							<text class="coupon-state">{{ coupon.saleStateText }}</text>
						</view>
						<text class="discovery-body">{{
							coupon.description || "暂无详细说明"
						}}</text>
					</view>
					<view class="discovery-detail-card">
						<text class="discovery-heading">优惠规则</text>
						<text v-if="coupon.minSpend != null" class="discovery-body">
							使用门槛：满 ¥{{ formatMoney(coupon.minSpend) }} 可用
						</text>
						<text v-if="coupon.discountAmount != null" class="discovery-body">
							满减金额：¥{{ formatMoney(coupon.discountAmount) }}
						</text>
						<text v-if="coupon.deductAmount != null" class="discovery-body">
							抵扣金额：¥{{ formatMoney(coupon.deductAmount) }}
						</text>
						<text v-if="coupon.discountRate != null" class="discovery-body">
							折扣：{{ coupon.discountRate }} 折
						</text>
						<text v-if="coupon.maxDiscount != null" class="discovery-body">
							最高优惠：¥{{ formatMoney(coupon.maxDiscount) }}
						</text>
						<text class="discovery-body">
							适用范围：{{ coupon.scopeType === 0 ? "商家全部营业门店" : "指定门店" }}
						</text>
						<text class="discovery-body">
							可叠加其他优惠：{{ coupon.allowCombine === 1 ? "可以" : "不可以" }}
						</text>
						<text v-if="coupon.perCustomerLimit != null" class="discovery-body">
							每位顾客限量：{{ coupon.perCustomerLimit }} 张
						</text>
						<text v-if="coupon.remainingStock != null" class="discovery-body">
							剩余数量：{{ coupon.remainingStock }}
						</text>
					</view>
					<view class="discovery-detail-card">
						<text class="discovery-heading">时间说明</text>
						<text class="discovery-body"
							>可领购时间：{{ coupon.saleStartTime || "不限" }} 至
							{{ coupon.saleEndTime || "不限" }}</text
						>
						<text class="discovery-body">有效期：{{ validityText }}</text>
					</view>
					<view class="discovery-detail-card">
						<text class="discovery-heading">适用门店</text>
						<view v-if="coupon.stores.length === 0" class="discovery-body">
							<text>暂无适用门店信息</text>
						</view>
						<navigator
							v-for="store in coupon.stores"
							:key="String(store.id)"
							class="coupon-store-row"
							:url="
								'/pages/discover/merchant?id=' +
								encodeURIComponent(String(store.id))
							"
						>
							<text>{{ store.name }}</text>
							<text class="discovery-caption">{{ store.address }} ›</text>
						</navigator>
					</view>
					<view v-if="coupon.contents.length > 0" class="discovery-detail-card">
						<text class="discovery-heading">适用商品或套餐</text>
						<view
							v-for="item in coupon.contents"
							:key="String(item.productId) + '-' + item.relationType"
							class="coupon-content-row"
						>
							<text
								>{{ item.relationType === 1 ? "适用范围" : "套餐内容" }} ·
								{{ item.quantity }} 份</text
							>
							<text class="discovery-caption">{{ item.description }}</text>
						</view>
					</view>
					<view class="discovery-detail-card">
						<text class="discovery-heading">{{
							coupon.salePrice === 0 ? "免费领取" : "购买优惠券"
						}}</text>
						<text class="discovery-body"
							>每次可选择1至20张，库存与每人限额以后端校验为准。</text
						>
						<view class="purchase-quantity"
							><text>数量 {{ quantity }} 张</text
							><cl-button
								size="small"
								border
								:disabled="busy || Boolean(purchaseKey) || quantity <= 1"
								aria-label="减少领取数量"
								@tap="quantity--"
								>－</cl-button
							><cl-button
								size="small"
								border
								:disabled="busy || Boolean(purchaseKey) || quantity >= 20"
								aria-label="增加领取数量"
								@tap="quantity++"
								>＋</cl-button
							></view
						>
						<text v-if="coupon.salePrice > 0" class="discovery-body"
							>下一步创建待支付订单，使用模拟支付，不会真实扣款。</text
						>
						<text v-if="purchaseError" class="purchase-error" role="alert">{{
							purchaseError
						}}</text>
						<view class="purchase-actions"
							><cl-button
								type="primary"
								:loading="busy"
								:disabled="
									busy ||
									(coupon.saleState !== 'AVAILABLE' &&
										!purchaseKey &&
										!createdOrderId)
								"
								@tap="purchase"
								>{{
									createdOrderId
										? "查看本次订单"
										: uncertain
											? "重试原操作"
											: !loggedIn
												? "登录后继续"
												: coupon.salePrice === 0
													? "确认领取"
													: "创建购券订单"
								}}</cl-button
							><cl-button v-if="createdOrderId" border @tap="newPurchase"
								>再次领购</cl-button
							><cl-button border @tap="router.to('/pages/trade/orders')"
								>我的订单</cl-button
							></view
						>
					</view>
				</template>
			</view>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { isDark, router, useStore } from "@/.cool";
import { computed, onUnmounted, ref, watch } from "vue";
import { claimCoupon, createOrder, createPurchaseRequestId } from "@/api/trade";
import { formatMoney, getApiErrorMessage, getCoupon } from "@/api/discovery";
import type { ApiId, CouponDetail } from "@/types/discovery";

const coupon = ref<CouponDetail | null>(null);
const loading = ref(false);
const error = ref("");
const imageFailed = ref(false);
let couponId: ApiId | "" = "";
let requestId = 0;
const { user } = useStore();
const quantity = ref(1),
	busy = ref(false),
	purchaseError = ref("");
const purchaseKey = ref(""),
	uncertain = ref(false),
	createdOrderId = ref("");
const loggedIn = computed(() => {
	void user.sessionVersion.value;
	return Boolean(user.token);
});
let purchaseVersion = 0;
function newPurchase() {
	if (busy.value) return;
	purchaseKey.value = "";
	createdOrderId.value = "";
	purchaseError.value = "";
	uncertain.value = false;
}
async function purchase() {
	if (!coupon.value || busy.value) return;
	if (!user.token) {
		router.to("/pages/user/login");
		return;
	}
	if (createdOrderId.value) {
		router.to("/pages/trade/order?id=" + encodeURIComponent(createdOrderId.value));
		return;
	}
	if (coupon.value.saleState !== "AVAILABLE" && !purchaseKey.value) return;
	const version = ++purchaseVersion,
		session = user.sessionVersion.value;
	purchaseKey.value ||= createPurchaseRequestId();
	busy.value = true;
	uncertain.value = true;
	purchaseError.value = "";
	try {
		const result = await (coupon.value.salePrice === 0 ? claimCoupon : createOrder)({
			couponTemplateId: coupon.value.id,
			quantity: quantity.value,
			requestId: purchaseKey.value
		});
		if (version !== purchaseVersion || session !== user.sessionVersion.value) return;
		createdOrderId.value = String(result.id);
		uncertain.value = false;
		router.to("/pages/trade/order?id=" + encodeURIComponent(createdOrderId.value));
	} catch (err) {
		if (version !== purchaseVersion || session !== user.sessionVersion.value) return;
		const businessError =
			err != null && typeof err === "object" && "code" in err && typeof err.code === "number";
		if (businessError) {
			purchaseKey.value = "";
			uncertain.value = false;
		}
		purchaseError.value =
			getApiErrorMessage(err, "本次操作暂未确认") +
			(uncertain.value ? "。请重试原操作，或先到我的订单查询，勿另建重复订单。" : "");
	} finally {
		if (version === purchaseVersion) busy.value = false;
	}
}
watch(user.sessionVersion, () => {
	purchaseVersion++;
	busy.value = false;
	newPurchase();
});
onHide(() => {
	purchaseVersion++;
	busy.value = false;
});
const validityText = computed(() => {
	if (!coupon.value) return "—";
	if (coupon.value.validityType === "FIXED") {
		return `${coupon.value.validFrom || "不限"} 至 ${coupon.value.validTo || "不限"}`;
	}
	return `发券后 ${coupon.value.validDays ?? "—"} 天`;
});

async function load() {
	if (couponId === "") {
		error.value = "缺少优惠券模板ID，无法加载详情";
		return;
	}
	const id = ++requestId;
	loading.value = true;
	error.value = "";
	try {
		const result = await getCoupon(couponId);
		if (id === requestId) {
			coupon.value = result;
			uni.setNavigationBarTitle({ title: result.name });
		}
	} catch (err) {
		if (id === requestId) {
			error.value = getApiErrorMessage(err, "优惠券详情暂不可用");
		}
	} finally {
		if (id === requestId) loading.value = false;
	}
}

onLoad((options) => {
	couponId = options?.id ?? "";
	load();
});

onUnmounted(() => {
	requestId++;
});
</script>

<style lang="scss" scoped>
@import "@/styles/discovery.scss";
.coupon-detail-card {
	background: #ffffff;
	border-radius: 16px;
	padding: 16px;
	margin-bottom: 12px;
}
.purchase-quantity,
.purchase-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	gap: 12px;
	margin-top: 16px;
}
.purchase-error {
	display: block;
	margin-top: 12px;
	color: #b42318;
	font-size: 14px;
	line-height: 1.6;
}
.is-dark .purchase-error {
	color: #ffb4ab;
}
.coupon-detail-image {
	width: 100%;
	height: 190px;
	border-radius: 12px;
	background: #e6ebf1;
}
.coupon-detail-image-fallback {
	display: flex;
	align-items: center;
	justify-content: center;
	color: #526d88;
}
.coupon-price-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin-top: 14px;
}
.coupon-price {
	font-size: 22px;
	font-weight: 700;
	color: #b35332;
}
.coupon-state {
	font-size: 13px;
	color: #71808d;
}
.coupon-store-row,
.coupon-content-row {
	display: flex;
	flex-direction: column;
	gap: 6px;
	padding: 12px 0;
	border-bottom: 1px solid #eef2f6;
}
.coupon-content-row:last-child {
	border-bottom: 0;
}
</style>
