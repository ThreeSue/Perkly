<template>
	<cl-page :back-top="false">
		<view class="discovery-page">
			<view class="discovery-content">
				<client-search v-model="keyword" @submit="search" @clear="search" />
				<view v-if="categoryError" class="category-error">
					<text>{{ categoryError }}</text>
					<button class="discovery-action" @tap="loadCategories">重试</button>
				</view>
				<view v-if="categories.length > 0" class="discovery-chips">
					<button
						class="discovery-action discovery-chip"
						:class="{ 'discovery-chip-selected': categoryId === '' }"
						@tap="selectCategory('')"
						hover-class="discovery-pressed"
					>
						全部
					</button>
					<button
						v-for="item in categories"
						:key="String(item.id)"
						class="discovery-action discovery-chip"
						:class="{ 'discovery-chip-selected': String(categoryId) === String(item.id) }"
						@tap="selectCategory(item.id)"
						hover-class="discovery-pressed"
					>
						{{ item.name }}
					</button>
				</view>
				<view v-if="loading" class="discovery-state" role="status">
					<text>门店加载中…</text>
				</view>
				<view v-else-if="error" class="discovery-state">
					<text>{{ error }}</text>
					<button class="discovery-action discovery-retry" @tap="search">重试</button>
				</view>
				<view v-else-if="stores.length === 0" class="discovery-state">
					<text>没有找到相关门店</text>
					<text class="discovery-caption">换个关键词或选择其他分类试试</text>
					<button
						class="discovery-action discovery-retry"
						@tap="reset"
						hover-class="discovery-pressed"
					>
						查看全部门店
					</button>
				</view>
				<view v-else class="discovery-grid">
					<view v-for="store in stores" :key="String(store.id)" class="discovery-cell">
						<client-merchant-card :store="store" />
					</view>
				</view>
				<template v-if="keyword.trim()">
					<view class="discovery-section-head search-coupon-head">
						<view><text class="discovery-heading">相关优惠券</text></view>
						<navigator class="discovery-link" :url="'/pages/discover/coupons?keyword=' + encodeURIComponent(keyword.trim())">
							查看全部 ›
						</navigator>
					</view>
					<view v-if="couponLoading" class="discovery-state" role="status">
						<text>优惠券搜索中…</text>
					</view>
					<view v-else-if="couponError" class="discovery-state">
						<text>{{ couponError }}</text>
						<button class="discovery-action discovery-retry" @tap="retryCoupons">重试</button>
					</view>
					<view v-else-if="searchCoupons.length === 0" class="discovery-state">
						<text>没有找到相关优惠券</text>
					</view>
					<view v-else class="coupon-grid">
						<view v-for="coupon in searchCoupons" :key="String(coupon.id)" class="coupon-cell">
							<client-coupon-card :coupon="coupon" />
						</view>
					</view>
				</template>
				<view v-if="moreError" class="discovery-state">
					<text>{{ moreError }}</text>
					<button class="discovery-action discovery-retry" @tap="loadMore">重试</button>
				</view>
				<button
					v-else-if="hasMore && !loading"
					class="discovery-action discovery-load-more"
					:disabled="loadingMore"
					@tap="loadMore"
				>
					{{ loadingMore ? "加载中…" : "加载更多" }}
				</button>
			</view>
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { computed, onUnmounted, ref } from "vue";
import { getApiErrorMessage, listCoupons, listIndustryCategories, listStores } from "@/api/discovery";
import type { ApiId, Coupon, IndustryCategory, Store } from "@/types/discovery";
import ClientSearch from "@/components/client-search.uvue";
import ClientMerchantCard from "@/components/client-merchant-card.uvue";
import ClientCouponCard from "@/components/client-coupon-card.uvue";

const keyword = ref("");
const categoryId = ref<ApiId | "">("");
const categories = ref<IndustryCategory[]>([]);
const stores = ref<Store[]>([]);
const searchCoupons = ref<Coupon[]>([]);
const loading = ref(false);
const couponLoading = ref(false);
const loadingMore = ref(false);
const error = ref("");
const couponError = ref("");
const moreError = ref("");
const categoryError = ref("");
const hasMore = ref(false);
let page = 1;
let requestId = 0;
let categoryRequestId = 0;

const title = computed(
	() => categories.value.find((item) => String(item.id) === String(categoryId.value))?.name ?? "发现好店"
);

async function loadCategories() {
	const id = ++categoryRequestId;
	categoryError.value = "";
	try {
		const result = await listIndustryCategories();
		if (id === categoryRequestId) {
			categories.value = result;
			uni.setNavigationBarTitle({ title: title.value });
		}
	} catch (err) {
		if (id === categoryRequestId) {
			categoryError.value = getApiErrorMessage(err, "行业分类加载失败");
		}
	}
}

function search() {
	uni.hideKeyboard();
	uni.setNavigationBarTitle({ title: title.value });
	const id = ++requestId;
	const query = keyword.value.trim();
	page = 1;
	stores.value = [];
	searchCoupons.value = [];
	error.value = "";
	couponError.value = "";
	moreError.value = "";
	loadingMore.value = false;
	loading.value = true;
	couponLoading.value = query !== "";
	hasMore.value = false;
	loadStorePage(id, query);
	if (query) loadCouponResults(id, query);
}

async function loadStorePage(id: number, query: string) {
	try {
		const result = await listStores({
			page: 1,
			size: 20,
			keyword: query,
			categoryId: categoryId.value || undefined
		});
		if (id === requestId) {
			stores.value = result.list;
			page = result.pagination.page;
			hasMore.value = stores.value.length < result.pagination.total;
		}
	} catch (err) {
		if (id === requestId) {
			error.value = getApiErrorMessage(err, "门店加载失败，请重试");
		}
	} finally {
		if (id === requestId) loading.value = false;
	}
}

async function loadCouponResults(id: number, query: string) {
	try {
		const result = await listCoupons({
			page: 1,
			size: 20,
			keyword: query,
			categoryId: categoryId.value || undefined
		});
		if (id === requestId) searchCoupons.value = result.list;
	} catch (err) {
		if (id === requestId) {
			couponError.value = getApiErrorMessage(err, "优惠券搜索失败，请重试");
		}
	} finally {
		if (id === requestId) couponLoading.value = false;
	}
}

function retryCoupons() {
	const query = keyword.value.trim();
	if (!query) return;
	const id = requestId;
	couponLoading.value = true;
	couponError.value = "";
	loadCouponResults(id, query);
}

async function loadMore() {
	if (loadingMore.value || !hasMore.value) return;
	const id = requestId;
	loadingMore.value = true;
	moreError.value = "";
	try {
		const result = await listStores({
			page: page + 1,
			size: 20,
			keyword: keyword.value,
			categoryId: categoryId.value || undefined
		});
		if (id === requestId) {
			stores.value = stores.value.concat(result.list);
			page = result.pagination.page;
			hasMore.value = stores.value.length < result.pagination.total;
		}
	} catch (err) {
		if (id === requestId) {
			moreError.value = getApiErrorMessage(err, "加载更多门店失败，请重试");
		}
	} finally {
		if (id === requestId) loadingMore.value = false;
	}
}

function selectCategory(value: ApiId | "") {
	categoryId.value = value;
	search();
}

function reset() {
	keyword.value = "";
	categoryId.value = "";
	search();
}

onLoad((options) => {
	const rawKeyword = String(options?.keyword ?? "");
	try {
		keyword.value = decodeURIComponent(rawKeyword);
	} catch {
		keyword.value = rawKeyword;
	}
	categoryId.value = String(options?.categoryId ?? "");
	loadCategories();
});

onShow(search);

onUnmounted(() => {
	requestId++;
	categoryRequestId++;
});
</script>

<style lang="scss" scoped>
@import "@/styles/discovery.scss";
.category-error {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 8px 12px;
	background: #ffffff;
	border-radius: 12px;
	color: #71808d;
	font-size: 12px;
}
.discovery-load-more {
	display: block;
	width: 100%;
	padding: 12px;
	text-align: center;
	color: #526d88;
}
.search-coupon-head {
	margin-top: 24px;
}
.coupon-grid {
	display: flex;
	flex-direction: column;
	gap: 10px;
}
.coupon-cell {
	width: 100%;
}
</style>
