<template>
	<view v-if="!loggedIn || loading || error || empty" class="trade-state" role="status">
		<view class="trade-state-symbol" aria-hidden="true"
			><cl-icon
				:name="
					!loggedIn
						? 'coupon-line'
						: loading
							? 'time-line'
							: error
								? 'cloud-off-line'
								: 'file-list-line'
				"
				:size="32"
		/></view>
		<text class="trade-state-title">{{
			!loggedIn
				? "好优惠，登录后收好"
				: loading
					? "正在读取"
					: error
						? "暂时无法加载"
						: "这里还没有记录"
		}}</text>
		<text class="trade-state-note">{{
			!loggedIn
				? "查看你的优惠券和购券订单，随时找到使用凭证"
				: loading
					? "正在读取…"
					: error || emptyText
		}}</text>
		<view class="trade-actions">
			<cl-button v-if="!loggedIn" type="primary" @tap="router.to('/pages/user/login')"
				>登录 / 注册</cl-button
			>
			<cl-button v-else-if="error && !loading" border @tap="$emit('retry')">重试</cl-button>
		</view>
	</view>
</template>
<script setup lang="ts">
import { router } from "@/.cool";
withDefaults(
	defineProps<{
		loggedIn: boolean;
		loading: boolean;
		error: string;
		empty: boolean;
		emptyText?: string;
	}>(),
	{ emptyText: "暂无记录" }
);
defineEmits<{ retry: [] }>();
</script>
