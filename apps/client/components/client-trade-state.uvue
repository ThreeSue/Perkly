.trade-state {
	padding: 36px 24px;
	min-height: 240px;
	box-sizing: border-box;
}
.trade-state-symbol {
	width: 70px;
	height: 70px;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 24px;
	background: $discovery-bg;
	color: $discovery-primary;
	margin: 0 auto 20px;
}
.trade-state-title {
	display: block;
	font-size: 18px;
	font-weight: 650;
}
.trade-state-note {
	display: block;
	margin-top: 10px;
	font-size: 13px;
	color: $discovery-muted;
	line-height: 1.8;
}
.trade-actions {
	margin-top: 24px;
}
.is-dark .trade-state-symbol {
	background: $discovery-dark-raised;
	color: $discovery-dark-primary;
}
.is-dark .trade-state-note {
	color: $discovery-dark-muted;
}
</style>
