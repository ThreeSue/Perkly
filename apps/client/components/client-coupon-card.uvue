<template>
	<navigator
		class="coupon-card"
		:class="{ 'is-dark': isDark }"
		:url="'/pages/discover/coupon?id=' + coupon.id"
	>
		<view class="coupon-cover">
			<image
				v-if="coupon.cover && !imageFailed"
				class="coupon-image"
				:src="coupon.cover"
				mode="aspectFill"
				@error="imageFailed = true"
			/>
			<text v-else class="coupon-cover-fallback">{{ coupon.typeText }}</text>
		</view>
		<view class="coupon-info">
			<view class="coupon-main">
				<text class="coupon-title">{{ coupon.name }}</text>
