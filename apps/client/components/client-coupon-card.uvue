					>{{ coupon.merchantName }} · {{ coupon.typeText }}</text
				>
			</view>
			<view class="coupon-price-row">
				<text class="coupon-price">¥{{ formatMoney(coupon.salePrice) }}</text>
				<text class="coupon-state">{{ coupon.saleStateText }}</text>
			</view>
		</view>
	</navigator>
</template>

<script setup lang="ts">
import { ref } from "vue";
import { isDark } from "@/.cool";
import { formatMoney } from "@/api/discovery";
import type { Coupon } from "@/types/discovery";

defineProps<{ coupon: Coupon }>();
const imageFailed = ref(false);
