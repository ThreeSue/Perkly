{
	"pages": [
		{
			"path": "pages/index/home",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "券管家"
			}
		},
		{
			"path": "pages/index/my",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的"
			}
		},
		{
			"path": "pages/index/template",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的券"
			}
		}
	],
	"subPackages": [
		{
			"root": "pages/discover",
			"pages": [
				{
					"path": "list",
					"style": {
						"navigationBarTitleText": "发现商家",
						"navigationBarBackgroundColor": "#eef2f6"
					}
				},
				{
					"path": "merchant",
					"style": {
						"navigationBarTitleText": "商家详情",
						"navigationBarBackgroundColor": "#eef2f6"
					}
				}
			]
		},
		{
			"root": "pages/set",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "设置"
					},
					"meta": {
						"isAuth": true
					}
				}
			]
		},
		{
			"root": "pages/user",
			"pages": [
				{
					"path": "edit",
					"style": {
						"navigationBarTitleText": "编辑资料"
					},
					"meta": {
						"isAuth": true
					}
				},
				{
					"path": "edit-name",
					"style": {
						"navigationStyle": "custom"
					},
					"meta": {
						"isAuth": true
					}
				},
				{
					"path": "login",
					"style": {
						"navigationStyle": "custom",
						"disableScroll": true
					}
				},
				{
					"path": "register",
					"style": {
						"navigationStyle": "custom"
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationBarTitleText": "券管家",
		"navigationBarTextStyle": "@navTextStyle",
		"backgroundColorContent": "@bgContentColor",
		"backgroundColor": "@bgColor",
		"navigationBarBackgroundColor": "@navBgColor"
	},
	"tabBar": {
		"custom": false,
		"color": "@tabColor",
		"selectedColor": "@tabSelectedColor",
		"backgroundColor": "@tabBgColor",
		"borderStyle": "@tabBorderStyle",
		"height": "60px",
		"list": [
			{
				"pagePath": "pages/index/home",
				"iconPath": "/static/icon/tabbar/home-bluegray.png",
				"selectedIconPath": "/static/icon/tabbar/home-bluegray-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/index/template",
				"iconPath": "/static/icon/tabbar/voucher.png",
				"selectedIconPath": "/static/icon/tabbar/voucher2.png",
				"text": "我的券"
			},
			{
				"pagePath": "pages/index/my",
				"iconPath": "/static/icon/tabbar/my-bluegray.png",
				"selectedIconPath": "/static/icon/tabbar/my-bluegray-active.png",
				"text": "我的"
			}
		]
	},
	"uniIdRouter": {}
}
