<template>
	<business-shell tab="home" title="工作台" monochrome>
		<merchant-admission-progress @notice="showNotice" />
		<view class="mono-work-hero">
			<view class="mono-store-row"
				><cl-icon name="store-2-line" :size="23" color="#202020" /><text
					class="mono-store-title"
					>{{ identity?.storeName || "正在验证门店" }}</text
				><text class="merchant-role-badge">{{ isManager ? "店长" : "员工" }}</text></view
			>
			<button
				class="uni-merchant-button mono-scan"
				role="button"
				:disabled="!canOperate || working"
				@tap="redemption?.scan()"
				@keydown.enter.prevent="redemption?.scan()"
				@keydown.space.prevent="redemption?.scan()"
			>
				<cl-icon name="qr-scan-line" :size="72" color="#202020" /><text>扫码核销</text>
			</button>
			<merchant-auth-button
				label="手动输入券码"
				secondary
				:disabled="!canOperate || working"
				@tap="redemption?.manual()"
			/>
		</view>
		<view class="mono-sheet mono-home-sheet">
			<text class="mono-section-title">核销说明</text>
			<text class="mono-secondary mono-store-note"
				>满减、折扣、代金券：填写本次消费金额，核对优惠和补款，线下收款后确认核销。</text
			>
			<text class="mono-secondary mono-store-note"
				>套餐、体验、兑换券：核对内容后确认使用，自动开单并核销。</text
			>
			<button
				class="uni-merchant-button mono-menu-row"
				role="button"
				@tap="records"
				@keydown.enter.prevent="records"
				@keydown.space.prevent="records"
			>
				<view class="mono-menu-icon"
					><cl-icon name="file-list-line" :size="27" color="#202020" /></view
				><view class="mono-menu-copy"
					><text class="mono-feature-title">{{
						isManager ? "全店核销记录" : "我的核销记录"
					}}</text
					><text class="mono-secondary"
						>查看流水及消费账单，继续处理待结算账单</text
					></view
				><cl-icon name="arrow-right-s-line" :size="23" color="#606060" />
			</button>
			<text class="mono-footnote">扫描或输入一次券码即可完成本笔处理。</text>
		</view>
	</business-shell>
	<merchant-redemption ref="redemption" @working="working = $event" />
	<cl-confirm ref="notice" />
</template>
<script setup lang="ts">
import { ref } from "vue";
import BusinessShell from "@/components/business-shell.uvue";
import MerchantAuthButton from "@/components/merchant-auth-button.uvue";
import MerchantRedemption from "@/components/merchant-redemption.uvue";
import MerchantAdmissionProgress from "@/components/merchant-admission-progress.uvue";
import { useMerchantAdmissionHome } from "@/composables/use-merchant-admission-home";
import {
	merchantCanOperate as canOperate,
	merchantIdentity as identity,
	merchantIsManager as isManager
} from "@/stores/merchant-auth";
const working = ref(false);
const redemption = ref<InstanceType<typeof MerchantRedemption> | null>(null);
const { notice, showNotice, show, hide } = useMerchantAdmissionHome();
onShow(show);
onHide(hide);
function records() {
	uni.switchTab({ url: "/pages/business/records" });
}
onHide(() => redemption.value?.hide());
</script>
